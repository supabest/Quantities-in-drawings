# Flask
SECRET_KEY=your-secret-key-change-this-in-production
FLASK_DEBUG=0
HOST=0.0.0.0
PORT=5000

# Database
# 默认 SQLite（开发无依赖）；Phase 5a 推荐切 PostgreSQL：
#   1) docker compose up -d db
#   2) 取消下行注释
# DATABASE_URL=postgresql://quant:quant_dev_pw@localhost:5432/decoration_quant
# E2E 测试库（仅当测试需要 PG 时设定，否则自动回退 SQLite）
# TEST_DATABASE_URL=postgresql://quant:quant_dev_pw@localhost:5432/decoration_quant_test

# Admin account (created on first run)
ADMIN_EMAIL=admin@decoration-quant.com
ADMIN_PASSWORD=change-this-password

# ── LLM 审计（Phase 4）—— 与套价系统共用同一套 GLM 配置 ──
# model 以 glm 开头自动路由智谱双端点（按量主端点 + Coding Plan 备端点）
# 不配置 LLM_API_KEY 时 AI 综合审计自动跳过，确定性审计不受影响
#LLM_API_KEY=your-zhipu-or-deepseek-api-key
#LLM_MODEL=glm-4.6
#LLM_MAX_TOKENS=8000
#LLM_TIMEOUT_SECONDS=180
#LLM_AUDIT_MAX_CALLS=5

# ── 套价系统联动 ──
#PRICING_API_BASE_URL=http://localhost:8000
#PRICING_API_KEY=
